<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT name="K1X" companyName="Stupid Systems LLC" version="0.0.1" userNotes="909-style kick drum."
              projectType="audioplug" pluginAUIsSandboxSafe="1" pluginManufacturer="Stupid Systems LLC"
              pluginManufacturerCode="Ssys" pluginCode="K1x1" cppLanguageStandard="17"
              pluginFormats="buildVST3,buildStandalone" pluginCharacteristicsValue="pluginIsSynth,pluginWantsMidiIn"
              useAppConfig="0" addUsingNamespaceToJuceHeader="1" id="k1xPrj1"
              jucerFormatVersion="1">
  <MAINGROUP id="k1xMain" name="K1X">
    <FILE id="logoPng1" name="logo.png" compile="0" resource="1" file="assets/logo.png"/>
    <GROUP id="srcGrp1" name="src">
      <FILE id="procH01" name="PluginProcessor.h" compile="0" resource="0"
