        <FILE id="scpH001" name="OutputScope.h" compile="0" resource="0" file="src/dsp/OutputScope.h"/>
      </GROUP>
      <GROUP id="prmGrp01" name="parameters">
        <FILE id="pidH001" name="ParameterIDs.h" compile="0" resource="0" file="src/parameters/ParameterIDs.h"/>
        <FILE id="plyH001" name="ParameterLayout.h" compile="0" resource="0"
              file="src/parameters/ParameterLayout.h"/>
      </GROUP>
      <GROUP id="uiGrp01" name="ui">
        <FILE id="verH001" name="VersionCompare.h" compile="0" resource="0"
              file="src/ui/VersionCompare.h"/>
      </GROUP>
    </GROUP>
  </MAINGROUP>
  <MODULES>
